# PostgreSQL connection (local service `pg17`, see README)
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/nepal_heritage_dev

# HS256 signing secret for access tokens — 32+ random bytes, never reuse
JWT_SECRET=change-me-32-random-bytes-minimum

# Server port
PORT=3000

# development | test | production
ENV=development
