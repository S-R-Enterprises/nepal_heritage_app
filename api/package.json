{
  "name": "nepal-heritage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the Nepal Heritage app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec:lint": "yamllint openapi.yaml",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/pg": "^8.15.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml-lint": "^1.7.0"
  },
  "overrides": {
    "mysql2": "^3.23.1"
  }
}
